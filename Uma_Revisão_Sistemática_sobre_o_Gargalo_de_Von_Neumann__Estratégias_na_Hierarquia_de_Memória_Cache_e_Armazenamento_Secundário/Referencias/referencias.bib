@article{maues2025, 
  title={Evolução da hierarquia de memória: impactos na arquitetura de sistemas computacionais e nas tendências de inovação tecnológica}, 
  volume={17}, 
  url={https://ojs.cuadernoseducacion.com/ojs/index.php/ced/article/view/10288}, 
  DOI={10.55905/cuadv17n12-041}, 
  abstractNote={&amp;lt;p&amp;gt;A evolução da hierarquia de memória representa um dos pilares fundamentais no avanço das arquiteturas de sistemas computacionais. Ao longo das últimas décadas, a busca por maior eficiência, velocidade e capacidade de armazenamento impulsionou o desenvolvimento de novas tecnologias, desde as memórias magnéticas até as soluções tridimensionais e persistentes. Este artigo tem como objetivo analisar os impactos dessa evolução na arquitetura de sistemas, abordando desde os conceitos clássicos até as inovações emergentes como memórias não voláteis, empilhamento 3D, computação em nuvem e paradigmas pós-Von Neumann. A pesquisa foi conduzida de forma bibliográfica e qualitativa, com base em autores contemporâneos e estudos técnicos recentes. Os resultados indicam que o aprimoramento das hierarquias de memória influencia diretamente o desempenho, a eficiência energética e o desenho das arquiteturas modernas, estabelecendo novas direções para o futuro da computação. Conclui-se que a integração entre memória e processamento, aliada ao uso de tecnologias sustentáveis e híbridas, será determinante para a próxima geração de sistemas inteligentes.&amp;lt;/p&amp;gt;}, number={12}, 
  journal={Cuadernos de Educación y Desarrollo }, 
  author={Maués, Joana Caroline da Silva and Nascimento, Emerson Leão Brito do}, 
  year={2025}, 
  month={dez.}, 
  pages={e10288}}

